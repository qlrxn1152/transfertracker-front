{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://transfertracker-back-v1-production.up.railway.app/api/:path*"
    },
    {
      "source": "/posts",
      "destination": "/"
    },
    {
      "source": "/teams",
      "destination": "/"
    },
    {
      "source": "/teams/:teamId",
      "destination": "/"
    },
    {
      "source": "/players",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
