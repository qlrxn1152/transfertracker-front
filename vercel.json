{
  "rewrites": [
    {
      "source": "/transfers",
      "destination": "/index.html"
    },
    {
      "source": "/posts",
      "destination": "/index.html"
    },
    {
      "source": "/teams",
      "destination": "/index.html"
    },
    {
      "source": "/teams/:teamId",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
