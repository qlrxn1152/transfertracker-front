{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://transfertracker-back-v1-production.up.railway.app/api/:path*"
    },
    {
      "source": "/transfers",
      "destination": "/index.html"
    },
    {
      "source": "/posts",
      "destination": "/index.html"
    },
    {
      "source": "/teams",
      "destination": "/index.html"
    },
    {
      "source": "/teams/:teamId",
      "destination": "/index.html"
    },
    {
      "source": "/players",
      "destination": "/index.html"
    }
  ]
}
